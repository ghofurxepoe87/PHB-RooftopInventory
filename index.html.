            <form onsubmit="handleAddNewItem(event)" class="space-y-4 mt-4 text-xs sm:text-sm">
                <div>
                    <label class="block font-semibold text-slate-700 mb-1">Nama Botol / Brand Minuman</label>
                    <input type="text" id="newItemName" class="w-full border border-slate-300 rounded-xl p-2.5 font-medium focus:ring-2 focus:ring-blue-500" placeholder="Contoh: Macallan 12 Years" required="">
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Kategori</label>
                        <select id="newItemCategory" class="w-full border border-slate-300 rounded-xl p-2.5 font-medium focus:ring-2 focus:ring-blue-500">
                            <option value="Spirits">Spirits</option>
                            <option value="Wine">Wine</option>
                            <option value="Beer">Beer</option>
                            <option value="Liqueur">Liqueur</option>
                            <option value="Aperitif &amp; Digestif">Aperitif &amp; Digestif</option>
                            <option value="Cocktail / RTD">Cocktail / RTD</option>
                            <option value="Soft Drinks">Soft Drinks</option>
                            <option value="Juices">Juices</option>
                            <option value="Syrups &amp; Flavors">Syrups &amp; Flavors</option>
                            <option value="Mixers &amp; Garnishes">Mixers &amp; Garnishes</option>
                            <option value="Coffee, Tea &amp; Dairy">Coffee, Tea &amp; Dairy</option>
                            <option value="Non-Alcoholic / Mocktails">Non-Alcoholic / Mocktails</option>
                        </select>
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Ukuran 1 Botol (ml)</label>
                        <input type="number" id="newItemCapacity" class="w-full border border-slate-300 rounded-xl p-2.5 font-medium" placeholder="750" value="750" required="">
                    </div>
                </div>

                <div>
                    <label class="block font-semibold text-slate-700 mb-1">Stok Awal (Jumlah Botol Utuh)</label>
                    <input type="number" step="0.1" id="newItemInitialBottles" class="w-full border border-slate-300 rounded-xl p-2.5 font-medium" placeholder="Contoh: 5 (akan dikali volume ml)" value="0" required="">
                </div>

                <div class="pt-3 flex items-center justify-end space-x-2">
                    <button type="button" onclick="closeAddItemModal()" class="px-4 py-2 rounded-xl text-slate-600 bg-slate-100 hover:bg-slate-200 font-semibold transition">
                        Batal
                    </button>
                    <button type="submit" class="px-5 py-2 rounded-xl text-white bg-blue-600 hover:bg-blue-500 font-bold shadow-lg shadow-blue-600/30 transition">
                        + Tambahkan Item
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- JavaScript Application Code -->
    <script>
        // Default Master Items with Bottle Capacity in ML
        const DEFAULT_ITEMS = [
            { id: 'item_1', name: 'Johnnie Walker Black Label', category: 'Spirits', bottleSizeMl: 750 },
            { id: 'item_2', name: 'Hendrick\'s Gin', category: 'Spirits', bottleSizeMl: 700 },
            { id: 'item_3', name: 'Absolut Vodka', category: 'Spirits', bottleSizeMl: 750 },
            { id: 'item_4', name: 'Jose Cuervo Reposado Tequila', category: 'Spirits', bottleSizeMl: 750 },
            { id: 'item_5', name: 'Penfolds Max\'s Shiraz Red Wine', category: 'Wine', bottleSizeMl: 750 },
            { id: 'item_6', name: 'Heineken Beer', category: 'Beer', bottleSizeMl: 330 },
            { id: 'item_7', name: 'Monin Syrup Hazelnut', category: 'Syrups & Flavors', bottleSizeMl: 700 },
            { id: 'item_8', name: 'Coca Cola', category: 'Soft Drinks', bottleSizeMl: 330 },
            { id: 'item_9', name: 'Campari Aperitif', category: 'Aperitif & Digestif', bottleSizeMl: 750 },
            { id: 'item_10', name: 'Kahlúa Coffee Liqueur', category: 'Liqueur', bottleSizeMl: 700 },
            { id: 'item_11', name: 'Ocean Spray Cranberry Juice', category: 'Juices', bottleSizeMl: 1000 },
            { id: 'item_12', name: 'Schweppes Tonic Water', category: 'Mixers & Garnishes', bottleSizeMl: 330 }
        ];

        // State Storage
        let masterItems = [];
        let currentYear = new Date().getFullYear();
        let currentMonth = new Date().getMonth(); // 0 - 11
        let currentDay = new Date().getDate();
        
        let inventoryData = {};

        window.onload = function() {
            initApp();
        };

        function initApp() {
            loadLocalStorageData();
            setupYearDropdown();
            document.getElementById('monthSelect').value = currentMonth;
            updateCalendarContext();
            renderActiveTab();
        }

        function loadLocalStorageData() {
            const savedItems = localStorage.getItem('bartrack_master_items_ml');
            if (savedItems) {
                masterItems = JSON.parse(savedItems);
            } else {
                masterItems = [...DEFAULT_ITEMS];
                saveMasterItems();
            }

            const savedInventory = localStorage.getItem('bartrack_inventory_data_ml');
            if (savedInventory) {
                inventoryData = JSON.parse(savedInventory);
            }
        }

        function saveMasterItems() {
            localStorage.setItem('bartrack_master_items_ml', JSON.stringify(masterItems));
        }

        function saveAllToLocalStorage() {
            localStorage.setItem('bartrack_inventory_data_ml', JSON.stringify(inventoryData));
        }

        function manualSaveWithFeedback() {
            saveAllToLocalStorage();
            showToast('Tersimpan', 'Semua perubahan data bar berhasil disimpan!');
        }

        function showToast(title, message) {
            const toast = document.getElementById('toastNotification');
            document.getElementById('toastTitle').textContent = title;
            document.getElementById('toastMessage').textContent = message;

            toast.classList.remove('translate-y-20', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');

            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }

        function setupYearDropdown() {
            const yearSelect = document.getElementById('yearSelect');
            yearSelect.innerHTML = '';
            for (let y = currentYear - 1; y <= currentYear + 2; y++) {
                const opt = document.createElement('option');
                opt.value = y;
                opt.textContent = y;
                opt.className = 'bg-navy-900 text-white';
                if (y === currentYear) opt.selected = true;
                yearSelect.appendChild(opt);
            }
        }

        function getDaysInMonth(year, month) {
            return new Date(year, month + 1, 0).getDate();
        }

        function updateCalendarContext() {
            currentMonth = parseInt(document.getElementById('monthSelect').value);
            currentYear = parseInt(document.getElementById('yearSelect').value);
            
            const totalDays = getDaysInMonth(currentYear, currentMonth);
            const daySelect = document.getElementById('daySelect');
            daySelect.innerHTML = '';

            for (let d = 1; d <= totalDays; d++) {
                const opt = document.createElement('option');
                opt.value = d;
                opt.textContent = d;
                opt.className = 'bg-navy-900 text-white';
                if (d === currentDay) opt.selected = true;
                daySelect.appendChild(opt);
            }

            if (currentDay > totalDays) currentDay = totalDays;
            daySelect.value = currentDay;

            document.getElementById('daysInMonthTag').textContent = `${totalDays} Hari`;
            updateDayContext();
        }

        function updateDayContext() {
            currentDay = parseInt(document.getElementById('daySelect').value);
            const monthNames = ["Januari", "Februari", "Maret", "April", "Mei", "Juni", "Juli", "Agustus", "September", "Oktober", "November", "Desember"];
            const formattedDate = `${currentDay} ${monthNames[currentMonth]} ${currentYear}`;
            
            document.getElementById('activeDateDisplay').textContent = formattedDate;
            document.getElementById('dashDateHeader').textContent = formattedDate;

            initDateRecord(getDateKey());
            renderActiveTab();
        }

        function getDateKey(day = currentDay, month = currentMonth, year = currentYear) {
            const m = String(month + 1).padStart(2, '0');
            const d = String(day).padStart(2, '0');
            return `${year}_${m}_${d}`;
        }

        // Helper untuk mendapatkan key tanggal kemarin (otomatis menyesuaikan perpindahan bulan/tahun)
        function getPreviousDayKey(day = currentDay, month = currentMonth, year = currentYear) {
            const dateObj = new Date(year, month, day);
            dateObj.setDate(dateObj.getDate() - 1);
            return getDateKey(dateObj.getDate(), dateObj.getMonth(), dateObj.getFullYear());
        }

        function initDateRecord(key) {
            if (!inventoryData[key]) {
                inventoryData[key] = {
                    opening: {},
                    sr: {},
                    closing: {},
                    modifiers: [],
                    entertainment: []
                };
            }
        }

        // Fungsi Ambil Opening Stock Efektif: Terintegrasi Otomatis dari Closing Kemarin
        function getEffectiveOpening(itemId, day = currentDay, month = currentMonth, year = currentYear) {
            const key = getDateKey(day, month, year);
            initDateRecord(key);

            // Jika pengguna sudah menginputkan nilai manual secara spesifik di tanggal tersebut
            if (inventoryData[key].opening[itemId] !== undefined) {
                return inventoryData[key].opening[itemId];
            }

            // Jika belum ada input manual, ambil closing dari tanggal kemarin
            const prevKey = getPreviousDayKey(day, month, year);
            if (inventoryData[prevKey] && inventoryData[prevKey].closing && inventoryData[prevKey].closing[itemId] !== undefined) {
                return parseFloat(inventoryData[prevKey].closing[itemId]) || 0;
            }

            return 0;
        }

        function switchTab(tabId) {
            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.classList.remove('bg-blue-600', 'text-white', 'font-semibold', 'shadow');
                btn.classList.add('text-slate-300', 'hover:bg-navy-800');
            });

            const activeBtn = document.getElementById(`tab-${tabId}`);
            if (activeBtn) {
                activeBtn.classList.remove('text-slate-300', 'hover:bg-navy-800');
                activeBtn.classList.add('bg-blue-600', 'text-white', 'font-semibold', 'shadow');
            }

            document.querySelectorAll('.view-section').forEach(sec => sec.classList.add('hidden'));
            const targetView = document.getElementById(`view-${tabId}`);
            if (targetView) targetView.classList.remove('hidden');

            renderActiveTab();
        }

        function renderActiveTab() {
            const key = getDateKey();
            initDateRecord(key);

            renderDashboard();
            renderOpeningStockTable();
            renderSRTable();
            renderClosingTable();
            renderModifierTab();
            renderEntertainmentTab();
            renderRecapTable();
        }

        function formatBottleMl(ml, sizeMl) {
            if (!sizeMl || sizeMl <= 0) return `${ml} ml`;
            const btl = Math.floor(ml / sizeMl);
            const rem = Math.round(ml % sizeMl);
            if (btl === 0) return `${rem} ml`;
            if (rem === 0) return `${btl} Btl (${ml} ml)`;
            return `${btl} Btl + ${rem} ml`;
        }

        function renderDashboard() {
            const key = getDateKey();
            const rec = inventoryData[key];

            document.getElementById('kpiTotalItems').textContent = masterItems.length;

            let totalSRMl = 0;
            Object.values(rec.sr || {}).forEach(val => totalSRMl += (parseFloat(val.totalMl) || 0));
            document.getElementById('kpiTotalSR').textContent = `${totalSRMl.toLocaleString()} ml`;

            let totalConsumedMl = 0;
            masterItems.forEach(item => {
                const sales = parseFloat(rec.closing[`${item.id}_pos`]) || 0;
                totalConsumedMl += sales;
            });
            document.getElementById('kpiTotalConsumed').textContent = `${totalConsumedMl.toLocaleString()} ml`;

            let totalEntSpillMl = 0;
            (rec.modifiers || []).forEach(m => totalEntSpillMl += (parseFloat(m.qty) || 0));
            (rec.entertainment || []).forEach(e => totalEntSpillMl += (parseFloat(e.qty) || 0));
            document.getElementById('kpiTotalEnt').textContent = `${totalEntSpillMl.toLocaleString()} ml`;

            // Dashboard Table
            const tbody = document.getElementById('dashboardSummaryTable');
            tbody.innerHTML = '';

            masterItems.forEach(item => {
                const op = getEffectiveOpening(item.id);
                const sr = parseFloat(rec.sr[item.id]?.totalMl) || 0;
                const exp = op + sr;

                let spill = 0;
                (rec.modifiers || []).filter(m => m.itemId === item.id).forEach(m => spill += parseFloat(m.qty) || 0);

                let ent = 0;
                (rec.entertainment || []).filter(e => e.itemId === item.id).forEach(e => ent += parseFloat(e.qty) || 0);

                const pos = parseFloat(rec.closing[`${item.id}_pos`]) || 0;
                const expectedClosing = exp - spill - ent - pos;

                const cl = rec.closing[item.id] !== undefined ? parseFloat(rec.closing[item.id]) : expectedClosing;
                const variance = cl - expectedClosing;

                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50 font-medium";
                tr.innerHTML = `
                    <td class="py-2.5 px-3 font-semibold text-navy-900">${item.name}</td>
                    <td class="py-2.5 px-2 text-center text-slate-500">${item.bottleSizeMl} ml</td>
                    <td class="py-2.5 px-2 text-center text-slate-600">${op} ml</td>
                    <td class="py-2.5 px-2 text-center text-blue-600 font-semibold">+${sr} ml</td>
                    <td class="py-2.5 px-2 text-center text-slate-700">${expectedClosing} ml</td>
                    <td class="py-2.5 px-2 text-center font-bold">${cl} ml</td>
                    <td class="py-2.5 px-2 text-center font-bold ${variance < 0 ? 'text-red-600 bg-red-50' : 'text-emerald-600'}">${variance} ml</td>
                `;
                tbody.appendChild(tr);
            });
        }

        function renderOpeningStockTable() {
            const key = getDateKey();
            const prevKey = getPreviousDayKey();
            const tbody = document.getElementById('openingStockTable');
            tbody.innerHTML = '';

            masterItems.forEach((item, index) => {
                const valMl = getEffectiveOpening(item.id);
                const btlEquivalent = formatBottleMl(valMl, item.bottleSizeMl);
                
                // Cek apakah nilai ini terisi otomatis dari closing kemarin
                const isAutoFromPrev = inventoryData[key].opening[item.id] === undefined && 
                                       inventoryData[prevKey] && 
                                       inventoryData[prevKey].closing && 
                                       inventoryData[prevKey].closing[item.id] !== undefined;

                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50";
                tr.innerHTML = `
                    <td class="py-3 px-4 font-bold text-slate-400">${index + 1}</td>
                    <td class="py-3 px-4 font-bold text-navy-900">
                        ${item.name}
                        ${isAutoFromPrev ? '<span class="ml-2 text-[10px] bg-blue-100 text-blue-700 font-bold px-1.5 py-0.5 rounded">Otomatis Closing Kemarin</span>' : ''}
                    </td>
                    <td class="py-3 px-4 text-xs font-semibold"><span class="bg-slate-100 text-slate-700 px-2 py-1 rounded-md">${item.category}</span></td>
                    <td class="py-3 px-4 text-center font-medium text-slate-600">${item.bottleSizeMl} ml / botol</td>
                    <td class="py-3 px-4 text-center">
                        <input type="number" step="1" value="${valMl}" onchange="updateOpeningStock('${item.id}', this.value)"
                            class="w-32 text-center bg-white border border-slate-300 rounded-xl p-2 font-bold text-navy-900 focus:ring-2 focus:ring-blue-500">
                    </td>
                    <td class="py-3 px-4 text-center text-xs font-bold text-blue-700">${btlEquivalent}</td>
                    <td class="py-3 px-4 text-center">
                        <button onclick="deleteMasterItem('${item.id}')" class="text-red-500 hover:text-red-700 text-xs font-bold p-1">
                            <i class="fa-solid fa-trash"></i> Hapus
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function updateOpeningStock(itemId, valMl) {
            const key = getDateKey();
            inventoryData[key].opening[itemId] = parseFloat(valMl) || 0;
            saveAllToLocalStorage();
            renderOpeningStockTable();
        }

        function copyClosingFromYesterday() {
            const prevKey = getPreviousDayKey();
            if (!inventoryData[prevKey] || !inventoryData[prevKey].closing) {
                alert('Data closing tanggal kemarin tidak ditemukan.');
                return;
            }

            const currentKey = getDateKey();
            masterItems.forEach(item => {
                const prevClosing = inventoryData[prevKey].closing[item.id] || 0;
                inventoryData[currentKey].opening[item.id] = prevClosing;
            });

            saveAllToLocalStorage();
            renderOpeningStockTable();
            showToast('Tersalin', 'Opening stock berhasil disalin dari closing kemarin!');
        }

        function renderSRTable() {
            const key = getDateKey();
            const rec = inventoryData[key];
            const tbody = document.getElementById('srTable');
            tbody.innerHTML = '';

            masterItems.forEach(item => {
                const srData = rec.sr[item.id] || { bottles: 0, totalMl: 0, ref: '', note: '' };
                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50";
                tr.innerHTML = `
                    <td class="py-3 px-4 font-bold text-navy-900">${item.name} (${item.bottleSizeMl}ml)</td>
                    <td class="py-3 px-4">
                        <input type="text" value="${srData.ref || ''}" onchange="updateSRData('${item.id}', 'ref', this.value)"
                            class="w-full bg-white border border-slate-300 rounded-xl p-2 text-xs" placeholder="No. SR-1234">
                    </td>
                    <td class="py-3 px-4 text-center">
                        <input type="number" step="0.5" value="${srData.bottles || 0}" onchange="updateSRData('${item.id}', 'bottles', this.value)"
                            class="w-28 text-center bg-white border border-slate-300 rounded-xl p-2 font-bold text-blue-600 focus:ring-2 focus:ring-blue-500">
                    </td>
                    <td class="py-3 px-4 text-center font-bold text-emerald-600 text-sm">
                        +${srData.totalMl || 0} ml
                    </td>
                    <td class="py-3 px-4">
                        <input type="text" value="${srData.note || ''}" onchange="updateSRData('${item.id}', 'note', this.value)"
                            class="w-full bg-white border border-slate-300 rounded-xl p-2 text-xs" placeholder="Keterangan SR">
                    </td>
                    <td class="py-3 px-4 text-center">
                        <span class="text-emerald-600 font-bold text-xs"><i class="fa-solid fa-check"></i> OK</span>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function updateSRData(itemId, field, val) {
            const key = getDateKey();
            if (!inventoryData[key].sr[itemId]) {
                inventoryData[key].sr[itemId] = { bottles: 0, totalMl: 0, ref: '', note: '' };
            }

            const item = masterItems.find(i => i.id === itemId);

            if (field === 'bottles') {
                const bottles = parseFloat(val) || 0;
                inventoryData[key].sr[itemId].bottles = bottles;
                inventoryData[key].sr[itemId].totalMl = bottles * (item ? item.bottleSizeMl : 750);
            } else {
                inventoryData[key].sr[itemId][field] = val;
            }

            saveAllToLocalStorage();
            renderSRTable();
        }

        function renderClosingTable() {
            const key = getDateKey();
            const rec = inventoryData[key];
            const tbody = document.getElementById('closingTable');
            tbody.innerHTML = '';

            masterItems.forEach(item => {
                const op = getEffectiveOpening(item.id);
                const srMl = parseFloat(rec.sr[item.id]?.totalMl) || 0;
                const totStockMl = op + srMl;

                // Sum Modifier/Spillage in ml
                let spillMl = 0;
                (rec.modifiers || []).filter(m => m.itemId === item.id).forEach(m => spillMl += parseFloat(m.qty) || 0);

                // Sum Entertainment in ml
                let entMl = 0;
                (rec.entertainment || []).filter(e => e.itemId === item.id).forEach(e => entMl += parseFloat(e.qty) || 0);

                const salesPOSMl = parseFloat(rec.closing[`${item.id}_pos`]) || 0;
                const expClosingMl = totStockMl - spillMl - entMl - salesPOSMl;

                const physicalClosingMl = rec.closing[item.id] !== undefined ? parseFloat(rec.closing[item.id]) : expClosingMl;
                const varianceMl = physicalClosingMl - expClosingMl;

                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50 font-medium";
                tr.innerHTML = `
                    <td class="py-3 px-3 font-bold text-navy-900">${item.name} (${item.bottleSizeMl}ml)</td>
                    <td class="py-3 px-2 text-center text-slate-600">${op}</td>
                    <td class="py-3 px-2 text-center text-blue-600">+${srMl}</td>
                    <td class="py-3 px-2 text-center font-bold bg-slate-100">${totStockMl}</td>
                    <td class="py-3 px-2 text-center text-amber-600">${spillMl}</td>
                    <td class="py-3 px-2 text-center text-purple-600">${entMl}</td>
                    <td class="py-3 px-2 text-center">
                        <input type="number" step="1" value="${salesPOSMl}" onchange="updateClosingField('${item.id}_pos', this.value)"
                            class="w-20 text-center bg-emerald-50 border border-emerald-200 rounded-lg p-1 font-bold text-emerald-900">
                    </td>
                    <td class="py-3 px-2 text-center font-bold bg-blue-50 text-blue-900">${expClosingMl}</td>
                    <td class="py-3 px-3 text-center">
                        <input type="number" step="1" value="${physicalClosingMl}" onchange="updateClosingField('${item.id}', this.value)"
                            class="w-28 text-center bg-white border border-slate-300 rounded-xl p-1.5 font-bold text-navy-900 focus:ring-2 focus:ring-blue-500">
                    </td>
                    <td class="py-3 px-3 text-center font-bold ${varianceMl < 0 ? 'text-red-600 bg-red-50' : 'text-emerald-600'}">
                        ${varianceMl} ml
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function updateClosingField(fieldKey, valMl) {
            const key = getDateKey();
            inventoryData[key].closing[fieldKey] = parseFloat(valMl) || 0;
            saveAllToLocalStorage();
            renderClosingTable();
        }

        function renderModifierTab() {
            populateItemDropdown('modItemSelect');
            const key = getDateKey();
            const rec = inventoryData[key];
            const tbody = document.getElementById('modifierLogTable');
            tbody.innerHTML = '';

            (rec.modifiers || []).forEach((m, idx) => {
                const item = masterItems.find(i => i.id === m.itemId);
                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50";
                tr.innerHTML = `
                    <td class="py-3 px-3 font-bold text-navy-900">${item ? item.name : 'Unknown Item'}</td>
                    <td class="py-3 px-3 text-xs"><span class="bg-amber-100 text-amber-800 px-2 py-0.5 rounded-md font-semibold">${m.type}</span></td>
                    <td class="py-3 px-3 text-center font-bold text-amber-700">${m.qty} ml</td>
                    <td class="py-3 px-3 text-slate-600 text-xs">${m.note}</td>
                    <td class="py-3 px-3 text-center">
                        <button onclick="deleteModifierLog(${idx})" class="text-red-500 hover:text-red-700 font-bold text-xs"><i class="fa-solid fa-trash"></i></button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function saveModifierLog(e) {
            e.preventDefault();
            const key = getDateKey();
            const itemId = document.getElementById('modItemSelect').value;
            const type = document.getElementById('modType').value;
            const qty = parseFloat(document.getElementById('modQty').value) || 0;
            const note = document.getElementById('modNote').value;

            inventoryData[key].modifiers.push({ itemId, type, qty, note });
            saveAllToLocalStorage();
            document.getElementById('modifierForm').reset();
            renderModifierTab();
            showToast('Tersimpan', 'Log modifier berhasil ditambahkan!');
        }

        function deleteModifierLog(idx) {
            const key = getDateKey();
            inventoryData[key].modifiers.splice(idx, 1);
            saveAllToLocalStorage();
            renderModifierTab();
        }

        function renderEntertainmentTab() {
            populateItemDropdown('entItemSelect');
            const key = getDateKey();
            const rec = inventoryData[key];
            const tbody = document.getElementById('entLogTable');
            tbody.innerHTML = '';

            (rec.entertainment || []).forEach((e, idx) => {
                const item = masterItems.find(i => i.id === e.itemId);
                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50";
                tr.innerHTML = `
                    <td class="py-3 px-3 font-bold text-navy-900">${item ? item.name : 'Unknown Item'}</td>
                    <td class="py-3 px-3 text-center font-bold text-purple-700">${e.qty} ml</td>
                    <td class="py-3 px-3 font-semibold text-xs text-navy-800">${e.approvedBy}</td>
                    <td class="py-3 px-3 text-slate-600 text-xs">${e.note}</td>
                    <td class="py-3 px-3 text-center">
                        <button onclick="deleteEntertainmentLog(${idx})" class="text-red-500 hover:text-red-700 font-bold text-xs"><i class="fa-solid fa-trash"></i></button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function saveEntertainmentLog(e) {
            e.preventDefault();
            const key = getDateKey();
            const itemId = document.getElementById('entItemSelect').value;
            const qty = parseFloat(document.getElementById('entQty').value) || 0;
            const approvedBy = document.getElementById('entApprovedBy').value;
            const note = document.getElementById('entNote').value;

            inventoryData[key].entertainment.push({ itemId, qty, approvedBy, note });
            saveAllToLocalStorage();
            document.getElementById('entForm').reset();
            renderEntertainmentTab();
            showToast('Tersimpan', 'Log entertainment berhasil ditambahkan!');
        }

        function deleteEntertainmentLog(idx) {
            const key = getDateKey();
            inventoryData[key].entertainment.splice(idx, 1);
            saveAllToLocalStorage();
            renderEntertainmentTab();
        }

        function populateItemDropdown(elementId) {
            const sel = document.getElementById(elementId);
            sel.innerHTML = '';
            masterItems.forEach(item => {
                const opt = document.createElement('option');
                opt.value = item.id;
                opt.textContent = `${item.name} (${item.bottleSizeMl}ml)`;
                sel.appendChild(opt);
            });
        }

        function renderRecapTable() {
            const totalDays = getDaysInMonth(currentYear, currentMonth);
            const selectedCategory = document.getElementById('recapCategoryFilter').value;
            const monthNames = ["Januari", "Februari", "Maret", "April", "Mei", "Juni", "Juli", "Agustus", "September", "Oktober", "November", "Desember"];
            
            document.getElementById('recapMonthSubtitle').textContent = `Periode: 1 - ${totalDays} ${monthNames[currentMonth]} ${currentYear}`;

            const tbody = document.getElementById('recapTableBody');
            tbody.innerHTML = '';

            const filteredItems = selectedCategory === 'ALL' ? masterItems : masterItems.filter(i => i.category === selectedCategory);

            filteredItems.forEach(item => {
                const lastDayKey = getDateKey(totalDays, currentMonth, currentYear);
                const initialMonthOpening = getEffectiveOpening(item.id, 1, currentMonth, currentYear);

                let totSRMl = 0;
                let totSpillMl = 0;
                let totEntMl = 0;
                let totSalesPOSMl = 0;

                for (let d = 1; d <= totalDays; d++) {
                    const dKey = getDateKey(d, currentMonth, currentYear);
                    const dRec = inventoryData[dKey];
                    if (dRec) {
                        totSRMl += parseFloat(dRec.sr[item.id]?.totalMl) || 0;
                        (dRec.modifiers || []).filter(m => m.itemId === item.id).forEach(m => totSpillMl += parseFloat(m.qty) || 0);
                        (dRec.entertainment || []).filter(e => e.itemId === item.id).forEach(e => totEntMl += parseFloat(e.qty) || 0);
                        totSalesPOSMl += parseFloat(dRec.closing[`${item.id}_pos`]) || 0;
                    }
                }

                const finalPhysicalClosingMl = inventoryData[lastDayKey]?.closing[item.id] !== undefined ? 
                    parseFloat(inventoryData[lastDayKey].closing[item.id]) : 0;

                const expFinalClosingMl = (initialMonthOpening + totSRMl) - totSpillMl - totEntMl - totSalesPOSMl;
                const totVarianceMl = finalPhysicalClosingMl - expFinalClosingMl;

                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50 font-medium";
                tr.innerHTML = `
                    <td class="py-3 px-3 font-bold text-navy-900">${item.name}</td>
                    <td class="py-3 px-2 text-center text-slate-500">${item.bottleSizeMl} ml</td>
                    <td class="py-3 px-2 text-center text-slate-600">${initialMonthOpening} ml</td>
                    <td class="py-3 px-2 text-center text-blue-600 font-bold">+${totSRMl} ml</td>
                    <td class="py-3 px-2 text-center text-amber-600">${totSpillMl} ml</td>
                    <td class="py-3 px-2 text-center text-purple-600">${totEntMl} ml</td>
                    <td class="py-3 px-2 text-center font-bold text-emerald-700">${totSalesPOSMl} ml</td>
                    <td class="py-3 px-2 text-center font-bold bg-slate-100">${finalPhysicalClosingMl} ml</td>
                    <td class="py-3 px-2 text-center font-bold ${totVarianceMl < 0 ? 'text-red-600 bg-red-50' : 'text-emerald-600'}">${totVarianceMl} ml</td>
                `;
                tbody.appendChild(tr);
            });
        }

        function openAddItemModal() {
            document.getElementById('addItemModal').classList.remove('hidden');
        }

        function closeAddItemModal() {
            document.getElementById('addItemModal').classList.add('hidden');
        }

        function handleAddNewItem(e) {
            e.preventDefault();
            const name = document.getElementById('newItemName').value.trim();
            const category = document.getElementById('newItemCategory').value;
            const capacity = parseFloat(document.getElementById('newItemCapacity').value) || 750;
            const initialBottles = parseFloat(document.getElementById('newItemInitialBottles').value) || 0;

            if (!name) return;

            const newItem = {
                id: 'item_' + Date.now(),
                name,
                category,
                bottleSizeMl: capacity
            };

            masterItems.push(newItem);
            saveMasterItems();

            const key = getDateKey();
            inventoryData[key].opening[newItem.id] = initialBottles * capacity;
            saveAllToLocalStorage();

            closeAddItemModal();
            renderActiveTab();
            showToast('Berhasil', `Botol "${name}" (${capacity}ml) berhasil ditambahkan!`);
        }

        function deleteMasterItem(itemId) {
            if (confirm('Apakah Anda yakin ingin menghapus item ini dari master data?')) {
                masterItems = masterItems.filter(i => i.id !== itemId);
                saveMasterItems();
                renderActiveTab();
            }
        }

        function exportToCSV() {
            const totalDays = getDaysInMonth(currentYear, currentMonth);
            const monthNames = ["Januari", "Februari", "Maret", "April", "Mei", "Juni", "Juli", "Agustus", "September", "Oktober", "November", "Desember"];
            
            let csv = `Laporan Rekapitulasi Bar Inventory (ml) - ${monthNames[currentMonth]} ${currentYear}\n`;
            csv += `Nama Item,Kategori,Ukuran Botol (ml),Opening (ml),SR In (ml),Spillage (ml),Entertainment (ml),Sales POS (ml),Closing Physical (ml),Variance (ml)\n`;

            masterItems.forEach(item => {
                const lastDayKey = getDateKey(totalDays, currentMonth, currentYear);
                const op = getEffectiveOpening(item.id, 1, currentMonth, currentYear);

                let totSR = 0, totSpill = 0, totEnt = 0, totSales = 0;
                for (let d = 1; d <= totalDays; d++) {
                    const dKey = getDateKey(d, currentMonth, currentYear);
                    const dRec = inventoryData[dKey];
                    if (dRec) {
                        totSR += parseFloat(dRec.sr[item.id]?.totalMl) || 0;
                        (dRec.modifiers || []).filter(m => m.itemId === item.id).forEach(m => totSpill += parseFloat(m.qty) || 0);
                        (dRec.entertainment || []).filter(e => e.itemId === item.id).forEach(e => totEnt += parseFloat(e.qty) || 0);
                        totSales += parseFloat(dRec.closing[`${item.id}_pos`]) || 0;
                    }
                }

                const cl = inventoryData[lastDayKey]?.closing[item.id] !== undefined ? parseFloat(inventoryData[lastDayKey].closing[item.id]) : 0;
                const exp = (op + totSR) - totSpill - totEnt - totSales;
                const variance = cl - exp;

                csv += `"${item.name}","${item.category}",${item.bottleSizeMl},${op},${totSR},${totSpill},${totEnt},${totSales},${cl},${variance}\n`;
            });

            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = `Bar_Inventory_Recap_ML_${monthNames[currentMonth]}_${currentYear}.csv`;
            link.click();
        }

        function exportJSONBackup() {
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify({
                masterItems,
                inventoryData
            }));
            const link = document.createElement('a');
            link.setAttribute("href", dataStr);
            link.setAttribute("download", `BarTrack_Pro_Backup_ML_${currentYear}_${currentMonth+1}.json`);
            document.body.appendChild(link);
            link.click();
            link.remove();
        }

        function exportHTMLFile() {
            const htmlContent = "<!DOCTYPE html>\n" + document.documentElement.outerHTML;
            const blob = new Blob([htmlContent], { type: 'text/html;charset=utf-8;' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = 'BarTrack_Pro_Inventory_System.html';
            document.body.appendChild(link);
            link.click();
            link.remove();
            showToast('Download Selesai', 'File HTML BarTrack Pro berhasil didownload!');
        }
    </script>

