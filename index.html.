                    <button onclick="openAddItemModal()" class="bg-blue-600 hover:bg-blue-500 text-white font-bold px-3 py-2 rounded-xl text-xs sm:text-sm transition shadow-lg shadow-blue-600/30 flex items-center space-x-2">
