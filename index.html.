<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Platinum Hotel Balikpapan - FBM Bar Inventory System</title>
    
    <!-- Tailwind CSS CDN dengan Autoload Fallback -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        const initTailwind = () => {
            if (typeof tailwind !== 'undefined') {
                tailwind.config = {
                    darkMode: 'class',
                    theme: {
                        extend: {
                            colors: {
                                navy: {
                                    50: '#f0f4f9', 100: '#e1e9f2', 200: '#c3d3e5',
                                    300: '#94b1d2', 400: '#5f88bc', 500: '#3b66a3',
                                    600: '#2b4e85', 700: '#1e3865', 800: '#172a4d',
                                    900: '#0f1d37', 950: '#0a1324'
                                }
                            }
                        }
                    }
                };
            } else {
                setTimeout(initTailwind, 10);
            }
        };
        initTailwind();
    </script>
    
    <!-- Font Awesome Icons & Google Fonts -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <style>
        body { font-family: 'Inter', sans-serif; }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #0f1d37; }
        ::-webkit-scrollbar-thumb { background: #1e3865; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #2b4e85; }
        .glass-header { background: rgba(10, 19, 36, 0.96); backdrop-filter: blur(8px); }
        .custom-shadow { box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.3); }
        
        /* Hilangkan elemen yang tidak perlu saat di-print */
        @media print {
            .no-print { display: none !important; }
            body { background: white !important; color: black !important; }
            .print-card { border: 1px solid #ccc !important; box-shadow: none !important; background: white !important; color: black !important; }
            .print-card * { color: black !important; border-color: #ccc !important; }
        }
    </style>
</head>
<body class="bg-navy-950 text-slate-200 min-h-screen flex flex-col antialiased selection:bg-amber-600 selection:text-white pb-12">

    <!-- Top Navigation & Header -->
    <header class="glass-header sticky top-0 z-30 shadow-xl border-b border-navy-800 no-print">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-wrap items-center justify-between py-3 gap-3">
                <!-- Brand Title & Logo PNG Asli -->
                <div class="flex items-center space-x-3">
                    <div class="p-1 rounded-xl shadow-md">
                        <!-- MEMANGGIL FILE GAMBAR logo.png -->
                        <img src="logo.png" alt="Logo Platinum Hotel" class="h-10 w-auto object-contain drop-shadow-md">
                    </div>
                    <div>
                        <h1 class="font-extrabold text-lg sm:text-xl tracking-wide text-white flex items-center gap-2">
                            Platinum Hotel <span class="text-amber-400">Balikpapan</span>
                        </h1>
                        <p class="text-xs text-amber-500 font-medium">FBM Bar Inventory & Volume Control System</p>
                    </div>
                </div>

                <!-- Date Context & Quick Actions -->
                <div class="flex flex-wrap items-center gap-2 sm:gap-3">
                    <div class="bg-navy-900 border border-navy-700 rounded-xl px-3 py-1.5 flex items-center space-x-2 text-xs sm:text-sm">
                        <i class="fa-regular fa-calendar-days text-amber-400"></i>
                        <select id="monthSelect" onchange="updateCalendarContext()" class="bg-transparent text-white font-semibold focus:outline-none cursor-pointer">
                            <option class="bg-navy-900 text-white" value="0">Januari</option>
                            <option class="bg-navy-900 text-white" value="1">Februari</option>
                            <option class="bg-navy-900 text-white" value="2">Maret</option>
                            <option class="bg-navy-900 text-white" value="3">April</option>
                            <option class="bg-navy-900 text-white" value="4">Mei</option>
                            <option class="bg-navy-900 text-white" value="5">Juni</option>
                            <option class="bg-navy-900 text-white" value="6">Juli</option>
                            <option class="bg-navy-900 text-white" value="7">Agustus</option>
                            <option class="bg-navy-900 text-white" value="8">September</option>
                            <option class="bg-navy-900 text-white" value="9">Oktober</option>
                            <option class="bg-navy-900 text-white" value="10">November</option>
                            <option class="bg-navy-900 text-white" value="11">Desember</option>
                        </select>
                        <select id="yearSelect" onchange="updateCalendarContext()" class="bg-transparent text-white font-semibold focus:outline-none cursor-pointer"></select>
                    </div>

                    <div class="bg-navy-900 border border-navy-700 rounded-xl px-3 py-1.5 flex items-center space-x-2 text-xs sm:text-sm">
                        <span class="text-slate-400 font-medium">Tgl:</span>
                        <select id="daySelect" onchange="updateDayContext()" class="bg-transparent text-amber-400 font-bold focus:outline-none cursor-pointer"></select>
                    </div>

                    <!-- Add New Item / Bottle Button -->
                    <button onclick="openAddItemModal()" class="bg-amber-500 hover:bg-amber-400 text-navy-950 font-bold px-3 py-2 rounded-xl text-xs sm:text-sm transition shadow-lg shadow-amber-500/30 flex items-center space-x-2">
                        <i class="fa-solid fa-plus-circle text-base"></i>
                        <span>+ Botol Baru</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Navigation Tabs -->
        <div class="bg-navy-950/80 border-t border-navy-800 backdrop-blur-md">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <nav class="flex space-x-1.5 overflow-x-auto py-2 scrollbar-none text-xs sm:text-sm font-medium" id="navigationTabs">
                    <button onclick="switchTab('dashboard')" id="tab-dashboard" class="nav-btn active px-3.5 py-2 rounded-xl bg-amber-500 text-navy-950 font-bold shadow flex items-center space-x-2 whitespace-nowrap transition">
                        <i class="fa-solid fa-chart-line"></i><span>Dashboard</span>
                    </button>
                    <button onclick="switchTab('opening')" id="tab-opening" class="nav-btn px-3.5 py-2 rounded-xl text-slate-300 hover:text-white hover:bg-navy-800 flex items-center space-x-2 whitespace-nowrap transition">
                        <i class="fa-solid fa-box-open"></i><span>Opening Stock (ml)</span>
                    </button>
                    <button onclick="switchTab('sr')" id="tab-sr" class="nav-btn px-3.5 py-2 rounded-xl text-slate-300 hover:text-white hover:bg-navy-800 flex items-center space-x-2 whitespace-nowrap transition">
                        <i class="fa-solid fa-truck-ramp-box"></i><span>Store Requisition (SR)</span>
                    </button>
                    <button onclick="switchTab('closing')" id="tab-closing" class="nav-btn px-3.5 py-2 rounded-xl text-slate-300 hover:text-white hover:bg-navy-800 flex items-center space-x-2 whitespace-nowrap transition">
                        <i class="fa-solid fa-clipboard-check"></i><span>Closing & Variance</span>
                    </button>
                    <button onclick="switchTab('modifier')" id="tab-modifier" class="nav-btn px-3.5 py-2 rounded-xl text-slate-300 hover:text-white hover:bg-navy-800 flex items-center space-x-2 whitespace-nowrap transition">
                        <i class="fa-solid fa-cocktail"></i><span>Modifier & Spillage (ml)</span>
                    </button>
                    <button onclick="switchTab('entertainment')" id="tab-entertainment" class="nav-btn px-3.5 py-2 rounded-xl text-slate-300 hover:text-white hover:bg-navy-800 flex items-center space-x-2 whitespace-nowrap transition">
                        <i class="fa-solid fa-glass-cheers"></i><span>Entertainment (ml)</span>
                    </button>
                    <button onclick="switchTab('recap')" id="tab-recap" class="nav-btn px-3.5 py-2 rounded-xl text-slate-300 hover:text-white hover:bg-navy-800 flex items-center space-x-2 whitespace-nowrap transition">
                        <i class="fa-solid fa-file-invoice-dollar"></i><span>Rekap Bulanan</span>
                    </button>
                </nav>
            </div>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-6 flex-1 w-full">

        <!-- Active Context Alert Banner -->
        <div class="bg-gradient-to-r from-navy-900 to-navy-800 text-white p-4 rounded-2xl mb-6 shadow-md border border-navy-700 flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center space-x-3">
                <div class="bg-amber-500/20 p-2 rounded-xl text-amber-400">
                    <i class="fa-solid fa-clock-rotate-left text-lg"></i>
                </div>
                <div>
                    <div class="text-xs text-slate-400 uppercase tracking-wider font-semibold">Sesi Kerja Aktif</div>
                    <div class="text-base font-bold text-white flex items-center gap-2">
                        <span id="activeDateDisplay">Memuat...</span>
                        <span class="text-xs bg-amber-500/20 text-amber-400 border border-amber-400/30 px-2 py-0.5 rounded-md" id="daysInMonthTag">30 Hari</span>
                    </div>
                </div>
            </div>
            <div class="flex items-center space-x-2 text-xs">
                <button onclick="manualSaveWithFeedback()" class="bg-emerald-600 hover:bg-emerald-500 text-white font-medium px-3.5 py-2 rounded-xl transition flex items-center gap-1.5 shadow active:scale-95">
                    <i class="fa-solid fa-floppy-disk"></i> <span>Simpan Data</span>
                </button>
                <button onclick="exportJSONBackup()" class="bg-navy-700 hover:bg-navy-600 border border-navy-600 text-white font-medium px-3 py-2 rounded-xl transition flex items-center gap-1.5">
                    <i class="fa-solid fa-download"></i> <span>Backup JSON</span>
                </button>
            </div>
        </div>

        <!-- Notification Toast -->
        <div id="toastNotification" class="fixed bottom-5 right-5 z-50 transform translate-y-20 opacity-0 transition-all duration-300 ease-in-out bg-emerald-600 text-white px-5 py-3 rounded-2xl shadow-2xl flex items-center space-x-3 border border-emerald-400/30 pointer-events-none">
            <div class="bg-white/20 p-2 rounded-xl">
                <i class="fa-solid fa-circle-check text-lg"></i>
            </div>
            <div>
                <h4 class="font-bold text-xs uppercase tracking-wider" id="toastTitle">Berhasil</h4>
                <p class="text-xs font-medium" id="toastMessage">Data berhasil disimpan!</p>
            </div>
        </div>

        <!-- SECTION 1: DASHBOARD -->
        <section id="view-dashboard" class="view-section space-y-6">
            <!-- Summary Stats KPI Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="glass-card p-5 rounded-2xl custom-shadow border-l-4 border-blue-500 bg-navy-800 border-y border-r border-navy-700">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Total Master Item</p>
                            <h3 class="text-2xl font-bold text-white mt-1" id="kpiTotalItems">0</h3>
                        </div>
                        <div class="p-3 bg-blue-500/20 text-blue-400 rounded-xl">
                            <i class="fa-solid fa-wine-bottle text-2xl"></i>
                        </div>
                    </div>
                </div>

                <div class="glass-card p-5 rounded-2xl custom-shadow border-l-4 border-amber-500 bg-navy-800 border-y border-r border-navy-700">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Store Requisition (SR)</p>
                            <h3 class="text-2xl font-bold text-white mt-1" id="kpiTotalSR">0 ml</h3>
                        </div>
                        <div class="p-3 bg-amber-500/20 text-amber-400 rounded-xl">
                            <i class="fa-solid fa-truck-ramp-box text-2xl"></i>
                        </div>
                    </div>
                </div>

                <div class="glass-card p-5 rounded-2xl custom-shadow border-l-4 border-emerald-500 bg-navy-800 border-y border-r border-navy-700">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Total Sales POS</p>
                            <h3 class="text-2xl font-bold text-white mt-1" id="kpiTotalConsumed">0 ml</h3>
                        </div>
                        <div class="p-3 bg-emerald-500/20 text-emerald-400 rounded-xl">
                            <i class="fa-solid fa-glass-water text-2xl"></i>
                        </div>
                    </div>
                </div>

                <div class="glass-card p-5 rounded-2xl custom-shadow border-l-4 border-purple-500 bg-navy-800 border-y border-r border-navy-700">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Ent. & Spillage</p>
                            <h3 class="text-2xl font-bold text-white mt-1" id="kpiTotalEnt">0 ml</h3>
                        </div>
                        <div class="p-3 bg-purple-500/20 text-purple-400 rounded-xl">
                            <i class="fa-solid fa-glass-cheers text-2xl"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Dashboard Details Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Status Inventory Today -->
                <div class="lg:col-span-2 glass-card bg-navy-800 rounded-2xl p-6 custom-shadow border border-navy-700">
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="text-lg font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-chart-pie text-amber-500"></i> Ringkasan Stok & Variansi Hari Ini
                        </h2>
                        <span class="text-xs font-medium text-slate-400" id="dashDateHeader">Memuat...</span>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse text-xs sm:text-sm">
                            <thead>
                                <tr class="bg-navy-900 text-amber-400 uppercase tracking-wider border-b border-navy-700">
                                    <th class="py-3 px-3">Nama Botol/Item</th>
                                    <th class="py-3 px-2 text-center">Ukuran</th>
                                    <th class="py-3 px-2 text-center">Opening (ml)</th>
                                    <th class="py-3 px-2 text-center">SR In (ml)</th>
                                    <th class="py-3 px-2 text-center">Expected (ml)</th>
                                    <th class="py-3 px-2 text-center">Closing (ml)</th>
                                    <th class="py-3 px-2 text-center">Variance (ml)</th>
                                </tr>
                            </thead>
                            <tbody id="dashboardSummaryTable"></tbody>
                        </table>
                    </div>
                </div>

                <!-- Quick Action Panel & Tips -->
                <div class="space-y-6">
                    <div class="glass-card rounded-2xl p-6 custom-shadow bg-gradient-to-br from-navy-900 to-navy-800 border border-navy-700 text-white">
                        <h3 class="font-bold text-base mb-3 flex items-center gap-2">
                            <i class="fa-solid fa-bolt text-amber-400"></i> Pintasan FBM
                        </h3>
                        <div class="space-y-2.5 text-xs">
                            <button onclick="switchTab('opening')" class="w-full bg-navy-800 hover:bg-navy-700 p-2.5 rounded-xl border border-navy-600 flex items-center justify-between text-left transition">
                                <span>1. Input Opening Stock (ml)</span>
                                <i class="fa-solid fa-chevron-right text-amber-400"></i>
                            </button>
                            <button onclick="switchTab('sr')" class="w-full bg-navy-800 hover:bg-navy-700 p-2.5 rounded-xl border border-navy-600 flex items-center justify-between text-left transition">
                                <span>2. Input Store Requisition</span>
                                <i class="fa-solid fa-chevron-right text-amber-400"></i>
                            </button>
                            <button onclick="switchTab('closing')" class="w-full bg-navy-800 hover:bg-navy-700 p-2.5 rounded-xl border border-navy-600 flex items-center justify-between text-left transition">
                                <span>3. Input Closing Count (ml)</span>
                                <i class="fa-solid fa-chevron-right text-amber-400"></i>
                            </button>
                        </div>
                    </div>

                    <div class="glass-card bg-navy-800 border border-navy-700 rounded-2xl p-6 custom-shadow">
                        <h3 class="font-bold text-white text-sm mb-2 flex items-center gap-2">
                            <i class="fa-solid fa-circle-info text-blue-400"></i> Standar Mililiter (ML)
                        </h3>
                        <p class="text-xs text-slate-400 leading-relaxed">
                            Semua perhitungan menggunakan mililiter (ml) untuk akurasi penuh. 1 botol Spirits standar umumnya berisi **750 ml** atau **700 ml**. 1 shot standar bar = **30 ml** atau **45 ml**.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION 2: OPENING STOCK -->
        <section id="view-opening" class="view-section hidden space-y-4">
            <div class="glass-card bg-navy-800 border border-navy-700 rounded-2xl p-6 custom-shadow">
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
                    <div>
                        <h2 class="text-xl font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-box-open text-amber-500"></i> Opening Stock Management
                        </h2>
                        <p class="text-xs text-slate-400">Stok awal otomatis terintegrasi dari closing tanggal sebelumnya</p>
                    </div>
                    <button onclick="copyClosingFromYesterday()" class="bg-navy-900 border border-navy-600 hover:bg-navy-700 text-white text-xs font-semibold px-4 py-2 rounded-xl transition flex items-center gap-2">
                        <i class="fa-solid fa-arrow-left-long text-amber-400"></i> Paksa Salin Closing Kemarin
                    </button>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse text-sm">
                        <thead>
                            <tr class="bg-navy-900 text-amber-400 uppercase text-xs tracking-wider border-b border-navy-700">
                                <th class="py-3.5 px-4 rounded-l-xl">No</th>
                                <th class="py-3.5 px-4">Nama Botol / Minuman</th>
                                <th class="py-3.5 px-4">Kategori</th>
                                <th class="py-3.5 px-4 text-center">Kapasitas Botol</th>
                                <th class="py-3.5 px-4 w-48 text-center">Stok Awal (ml)</th>
                                <th class="py-3.5 px-4 text-center">Ekuivalen Botol</th>
                                <th class="py-3.5 px-4 rounded-r-xl text-center">Aksi</th>
                            </tr>
                        </thead>
                        <tbody id="openingStockTable"></tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- SECTION 3: STORE REQUISITION (SR) -->
        <section id="view-sr" class="view-section hidden space-y-4">
            <div class="glass-card bg-navy-800 border border-navy-700 rounded-2xl p-6 custom-shadow">
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
                    <div>
                        <h2 class="text-xl font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-truck-ramp-box text-amber-500"></i> Store Requisition (Penerimaan)
                        </h2>
                        <p class="text-xs text-slate-400">Pencatatan pasokan dari gudang utama ke bar dalam jumlah botol</p>
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse text-sm">
                        <thead>
                            <tr class="bg-navy-900 text-amber-400 uppercase text-xs tracking-wider border-b border-navy-700">
                                <th class="py-3.5 px-4 rounded-l-xl">Nama Botol</th>
                                <th class="py-3.5 px-4">Nomor SR / Invois</th>
                                <th class="py-3.5 px-4 w-36 text-center">Jumlah Botol Masuk</th>
                                <th class="py-3.5 px-4 text-center">Total Volume (ml)</th>
                                <th class="py-3.5 px-4">Catatan</th>
                                <th class="py-3.5 px-4 rounded-r-xl text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody id="srTable"></tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- SECTION 4: CLOSING & VARIANCE -->
        <section id="view-closing" class="view-section hidden space-y-4">
            <div class="glass-card bg-navy-800 border border-navy-700 rounded-2xl p-6 custom-shadow">
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
                    <div>
                        <h2 class="text-xl font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-clipboard-check text-amber-500"></i> Daily Closing & Physical Inventory
                        </h2>
                        <p class="text-xs text-slate-400">Input stok fisik penutupan bar dalam Mililiter (ml) & analisis variance</p>
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse text-xs sm:text-sm">
                        <thead>
                            <tr class="bg-navy-900 text-amber-400 uppercase tracking-wider border-b border-navy-700">
                                <th class="py-3.5 px-3 rounded-l-xl">Nama Botol</th>
                                <th class="py-3.5 px-2 text-center">Opn (ml)</th>
                                <th class="py-3.5 px-2 text-center">SR In</th>
                                <th class="py-3.5 px-2 text-center bg-navy-950">Tot Stock</th>
                                <th class="py-3.5 px-2 text-center text-amber-300">Spill/Mod</th>
                                <th class="py-3.5 px-2 text-center text-purple-300">Ent/Duty</th>
                                <th class="py-3.5 px-2 text-center text-emerald-300">POS (ml)</th>
                                <th class="py-3.5 px-2 text-center text-blue-300">Expected</th>
                                <th class="py-3.5 px-3 text-center w-36">Closing Fisik (ml)</th>
                                <th class="py-3.5 px-3 text-center rounded-r-xl">Variance (ml)</th>
                            </tr>
                        </thead>
                        <tbody id="closingTable"></tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- SECTION 5: MODIFIER & SPILLAGE -->
        <section id="view-modifier" class="view-section hidden space-y-4">
            <div class="glass-card bg-navy-800 border border-navy-700 rounded-2xl p-6 custom-shadow">
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
                    <div>
                        <h2 class="text-xl font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-cocktail text-amber-500"></i> Modifier, Cocktail Recipe & Spillage Log
                        </h2>
                        <p class="text-xs text-slate-400">Catat pemakaian racikan atau tumpahan langsung dalam Mililiter (ml)</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div class="bg-navy-900 p-5 rounded-2xl border border-navy-700">
                        <h3 class="font-bold text-white text-sm mb-4">Catat Modifier / Wastage Baru</h3>
                        <form id="modifierForm" onsubmit="saveModifierLog(event)" class="space-y-3 text-xs">
                            <div>
                                <label class="block font-semibold text-slate-300 mb-1">Pilih Botol/Item</label>
                                <select id="modItemSelect" class="w-full bg-navy-950 border border-navy-600 rounded-xl p-2.5 font-medium text-white focus:ring-2 focus:ring-amber-500" required></select>
                            </div>
                            <div>
